{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!libs/contracts/dist",
      "!libs/contracts/src/generated.ts",
      "!libs/contracts/src/events.ts",
      "!libs/contracts/src/business.ts",
      "!docs/design/screens",
      "!examples/kubernetes-docs/docs",
      "!examples/decisive-test/kubernetes/docs",
      "!examples/company-drive/drive/research"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 40
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["engine/page-compiler/src/topics.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 145
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/bench/src/cli.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 100
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/bench/src/synthesize.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 80
              }
            }
          }
        }
      }
    },
    {
      "includes": ["engine/agent-runtime/src/runtime.ts", "engine/page-compiler/src/cluster.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 65
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "engine/extraction/src/extract.ts",
        "engine/freshness/src/freshness.ts",
        "engine/knowledge-store/src/base.ts",
        "engine/normalization/src/blocks.ts",
        "engine/normalization/src/parsers/html.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 45
              }
            }
          }
        }
      }
    }
  ]
}
