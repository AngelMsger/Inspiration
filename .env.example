# Copy to .env. Keep credentials on this computer; .env is ignored by git.
INSPIRATION_DEEPSEEK_API_KEY=

# Confluence Data Center / Server: include a context path if the site uses one.
INSPIRATION_CONFLUENCE_URL=https://confluence.example.com
INSPIRATION_CONFLUENCE_TOKEN=

# Feishu self-built internal app, published with document read permissions.
INSPIRATION_FEISHU_APP_ID=
INSPIRATION_FEISHU_APP_SECRET=

# Optional: trust your company's CA for Node HTTPS requests.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem

# Local services bind only to loopback. Change these if the defaults are occupied.
# INSPIRATION_PUBLIC_URL=http://localhost:4200
# INSPIRATION_ENGINE_URL=http://127.0.0.1:4100
# INSPIRATION_PG_PORT=5432
# INSPIRATION_VALKEY_PORT=6379
# INSPIRATION_SPICEDB_PORT=50051
# INSPIRATION_SPICEDB_HTTP_PORT=8443
