{
  "name": "inspiration-workspace",
  "private": true,
  "description": "Inspiration monorepo: workspace root (not a package)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "contracts": "node libs/contracts/codegen/generate.ts",
    "contracts:check": "node libs/contracts/codegen/generate.ts --check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "INSPIRATION_STACK=off vitest run",
    "engine": "node apps/engine/src/cli.ts"
  },
  "dependencies": {
    "@inspiration/access-control": "workspace:*",
    "@inspiration/agent-runtime": "workspace:*",
    "@inspiration/collaboration": "workspace:*",
    "@inspiration/connectors": "workspace:*",
    "@inspiration/contracts": "workspace:*",
    "@inspiration/engine": "workspace:*",
    "@inspiration/eventbus": "workspace:*",
    "@inspiration/extraction": "workspace:*",
    "@inspiration/freshness": "workspace:*",
    "@inspiration/governance": "workspace:*",
    "@inspiration/kernel": "workspace:*",
    "@inspiration/knowledge-store": "workspace:*",
    "@inspiration/model-gateway": "workspace:*",
    "@inspiration/normalization": "workspace:*",
    "@inspiration/page-compiler": "workspace:*",
    "@inspiration/retrieval": "workspace:*",
    "@inspiration/source-sync": "workspace:*",
    "@inspiration/testkit": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
