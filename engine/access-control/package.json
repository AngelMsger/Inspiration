{
  "name": "@inspiration/access-control",
  "version": "0.1.0",
  "description": "Access control: permissions on SpiceDB, visibility by space, the directory copy and the spaces in its own schema, search pre-filters, the derived-knowledge rule, principal tokens",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "bin": {
    "inspiration-authz-schema": "./src/cli/write-schema.ts"
  },
  "dependencies": {
    "@authzed/authzed-node": "^1.6.1",
    "@inspiration/contracts": "workspace:*",
    "@inspiration/eventbus": "workspace:*",
    "@inspiration/kernel": "workspace:*"
  },
  "devDependencies": {
    "@inspiration/knowledge-store": "workspace:*",
    "@inspiration/testkit": "workspace:*"
  },
  "inspiration": {
    "plugins": {
      "migrations": {
        "authz": "./src/migrations.ts#MIGRATIONS"
      }
    }
  }
}
