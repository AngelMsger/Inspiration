// Inspiration permission schema (SpiceDB). Access control owns it; apply it with `make authz-schema`.
//
// Visibility comes from spaces: a source belongs to one space, and its documents are readable by
// whoever may read the space. Source ACLs decide nothing here; source-sync keeps them as advisory
// snapshots. Derived knowledge (claims, pages, SOPs) is not stored here: access control decides it
// at read time from the documents behind each claim, so it follows the spaces the viewer can read now.

/**
 * A member: one person inside one tenant (mem_), provisioned by the business layer's directory.
 * Principal IDs are unique only within their tenant, so members, services, groups and
 * departments have the object ID "<tenant id>|<principal id>" (see principalObjectId in
 * src/service.ts).
 */
definition member {}

/** An internal service account: pipelines and governance agents. */
definition service {}

definition group {
    relation member: member | group#member
}

/** Departments nest: a department's members include its sub-departments' members. */
definition department {
    relation member: member | department#member
}

definition tenant {
    relation admin: member
    relation member: member | group#member | department#member
    relation service: service

    // Sensitivity clearance above the default "internal" of every member.
    relation confidential_reader: member | group#member | department#member
    relation secret_reader: member | group#member

    permission administer = admin
    permission everyone = member + admin
    permission system = service
    permission clear_secret = secret_reader + system
    permission clear_confidential = confidential_reader + clear_secret
}

definition space {
    relation tenant: tenant
    relation parent: space
    relation owner: member
    relation steward: member | group#member
    relation editor: member | group#member | department#member
    relation commenter: member | group#member | department#member | tenant#member
    relation viewer: member | group#member | department#member | tenant#member

    // Roles hold in every space below: a parent's owner owns its children.
    permission system = tenant->system
    permission own = owner + parent->own
    permission verify = steward + own + parent->verify
    permission publish = verify
    permission edit = editor + verify + parent->edit
    permission comment = commenter + edit + parent->comment
    permission read = viewer + comment + system + parent->read
    permission discover = read

    // Administering a space (its name, owners and audience) is for its owners and the tenant's
    // admins. A tenant admin manages every space but reads only those whose audience includes them.
    permission admin = own + tenant->administer
}

definition source {
    relation space: space

    permission system = space->system
    permission admin = space->admin
    permission read = space->read
}
