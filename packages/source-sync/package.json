{
  "name": "@inspiration/source-sync",
  "version": "0.1.0",
  "description": "Source sync: listing, change detection, source versions, ACL snapshots and tombstones",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "inspiration": {
    "plugins": {
      "migrations": {
        "sync": "./src/migrations.ts#MIGRATIONS"
      }
    }
  },
  "dependencies": {
    "@inspiration/contracts": "workspace:*",
    "@inspiration/eventbus": "workspace:*",
    "@inspiration/kernel": "workspace:*"
  },
  "devDependencies": {
    "@inspiration/connectors": "workspace:*",
    "@inspiration/knowledge-store": "workspace:*",
    "@inspiration/testkit": "workspace:*"
  }
}
