{
  "name": "@inspiration/normalization",
  "version": "0.1.0",
  "description": "Normalization: parser routing, source blocks and spans with stable IDs, block diff, duplicate documents",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "inspiration": {
    "plugins": {
      "parsers": {
        "markdown": "./src/parsers/markdown.ts#markdownParser",
        "text": "./src/parsers/text.ts#textParser",
        "html": "./src/parsers/html.ts#htmlParser",
        "csv": "./src/parsers/csv.ts#csvParser"
      },
      "migrations": {
        "normalization": "./src/migrations.ts#MIGRATIONS"
      }
    }
  },
  "dependencies": {
    "@inspiration/contracts": "workspace:*",
    "@inspiration/eventbus": "workspace:*",
    "@inspiration/kernel": "workspace:*",
    "csv-parse": "^7.0.3",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@inspiration/knowledge-store": "workspace:*",
    "@inspiration/testkit": "workspace:*",
    "@types/mdast": "^4.0.4"
  }
}
