// Inspiration permission schema (SpiceDB). Access control owns it; apply it with `make authz-schema`.
//
// Source documents keep the ACL of the system they came from (mirrored by access control from
// acl.changed). Spaces hold Inspiration's own roles. Derived knowledge (claims, pages,
// SOPs) is not stored here: access control decides it at read time from the documents behind each
// claim, so it always follows the sources the viewer can read now.

/** A person's membership of a tenant (usr_), provisioned by the business layer's directory. */
definition user {}

/** An internal service account: pipelines and governance agents. */
definition service {}

definition group {
    relation member: user | group#member
}

/** Departments nest: a department's members include its sub-departments' members. */
definition department {
    relation member: user | department#member
}

definition tenant {
    relation admin: user
    relation member: user | group#member | department#member
    relation service: service

    // Sensitivity clearance above the default "internal" of every member.
    relation confidential_reader: user | group#member | department#member
    relation secret_reader: user | group#member

    permission administer = admin
    permission everyone = member + admin
    permission system = service
    permission clear_secret = secret_reader + system
    permission clear_confidential = confidential_reader + clear_secret
}

definition space {
    relation tenant: tenant
    relation parent: space
    relation owner: user
    relation steward: user | group#member
    relation editor: user | group#member | department#member
    relation commenter: user | group#member | department#member | tenant#member
    relation viewer: user | group#member | department#member | tenant#member

    permission system = tenant->system
    permission admin = owner + tenant->administer + parent->admin
    permission verify = steward + admin
    permission publish = steward + admin
    permission edit = editor + verify + parent->edit
    permission comment = commenter + edit + parent->comment
    permission read = viewer + comment + system + parent->read
    permission discover = read
}

definition source {
    relation space: space

    permission system = space->system
    permission admin = space->admin
    permission read = space->read
}

/** A source document. Its ID is "<source id>|<external id>" (see documentObjectId in src/service.ts). */
definition document {
    relation source: source
    relation parent: document
    relation owner: user | group#member | department#member
    relation editor: user | group#member | department#member
    relation commenter: user | group#member | department#member
    relation viewer: user | group#member | department#member | tenant#member

    // "Anyone in the company with the link": readable, and reported by the oversharing scan.
    relation link_viewer: tenant#member
    relation public_viewer: user:*

    permission read = viewer + commenter + editor + owner + link_viewer + public_viewer + parent->read + source->system
    permission discover = read
}
